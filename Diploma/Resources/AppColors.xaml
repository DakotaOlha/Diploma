<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── Backgrounds ── -->
    <SolidColorBrush x:Key="BgDarkBrush"     Color="#102020"/>
    <SolidColorBrush x:Key="BgMidBrush"      Color="#2D4C4F"/>
    <SolidColorBrush x:Key="BgCardBrush"     Color="#1B2E2F"/>
    <SolidColorBrush x:Key="BgCardDimBrush"  Color="#162828"/>
    <SolidColorBrush x:Key="BgNavSelBrush"   Color="#1A3030"/>

    <!-- ── Accents ── -->
    <SolidColorBrush x:Key="AccentRedBrush"  Color="#83241E"/>
    <SolidColorBrush x:Key="AccentTealBrush" Color="#78B4B7"/>
    <SolidColorBrush x:Key="AccentGoldBrush" Color="#BD8B33"/>

    <!-- ── Text ── -->
    <SolidColorBrush x:Key="TextLightBrush"  Color="#D9E9E9"/>
    <SolidColorBrush x:Key="TextMutedBrush"  Color="#9FA6A6"/>
    <SolidColorBrush x:Key="TextDimBrush"    Color="#506870"/>

    <!-- ── Borders ── -->
    <SolidColorBrush x:Key="BorderMidBrush"    Color="#404D4D"/>
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#577072"/>

</ResourceDictionary>
