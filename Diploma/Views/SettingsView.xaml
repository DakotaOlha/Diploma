<UserControl x:Class="Diploma.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgDarkBrush}">

    <UserControl.Resources>

        <!-- ── Save button ── -->
        <Style x:Key="SaveBtnStyle" TargetType="Button">
            <Setter Property="Background"      Value="#2D4C4F"/>
            <Setter Property="BorderBrush"     Value="#577072"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground"      Value="#D9E9E9"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="24,0"/>
            <Setter Property="Height"          Value="36"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background"  Value="#3D6069"/>
                                <Setter TargetName="B" Property="BorderBrush" Value="#78B4B7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#1B3A3D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Card border base style (active card highlighted in gold) ── -->
        <Style x:Key="ModeCardBorderBase" TargetType="Border">
            <Setter Property="CornerRadius"    Value="10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="#2A3E40"/>
            <Setter Property="Background"      Value="{StaticResource BgCardBrush}"/>
            <Setter Property="Padding"         Value="14,12"/>
            <Setter Property="Margin"          Value="0,0,0,8"/>
        </Style>

        <!-- ComboBox override for card-dark bg -->
        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox"
               BasedOn="{StaticResource CustomComboBoxStyle}">
            <Setter Property="Background"   Value="#1B2E2F"/>
            <Setter Property="BorderBrush"  Value="#577072"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ════════════════════════════════════════════
             LEFT SIDEBAR
             ════════════════════════════════════════════ -->
        <Grid Grid.Column="0" Background="{StaticResource BgDarkBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal"
                        Margin="20,22,16,20" VerticalAlignment="Center">
                <TextBlock Text="⚙" FontSize="17" FontWeight="Bold"
                           Foreground="{StaticResource AccentGoldBrush}"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="Налаштування" FontSize="17" FontWeight="Bold"
                           Foreground="{StaticResource AccentGoldBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Separator -->
            <Rectangle Grid.Row="1" Height="1"
                       Fill="{StaticResource BorderMidBrush}" Margin="0,0,0,4"/>

            <!-- Nav -->
            <ListBox Grid.Row="2"
                     SelectedIndex="{Binding SelectedSection, Mode=TwoWay}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBoxItem Style="{StaticResource NavItemStyle}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📋" FontSize="14" Margin="0,0,10,0"/>
                        <TextBlock Text="Загальні" FontSize="14"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Style="{StaticResource NavItemStyle}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🗂" FontSize="14" Margin="0,0,10,0"/>
                        <TextBlock Text="Логування" FontSize="14"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Style="{StaticResource NavItemStyle}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⌨" FontSize="14" Margin="0,0,10,0"/>
                        <TextBlock Text="Гарячі клавіші" FontSize="14"/>
                    </StackPanel>
                </ListBoxItem>
            </ListBox>

            <!-- Version -->
            <TextBlock Grid.Row="3" Text="AlgoReplay"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource TextDimBrush}"
                       FontSize="10" Margin="0,0,0,12"/>
        </Grid>

        <!-- ════════════════════════════════════════════
             RIGHT CONTENT PANEL
             ════════════════════════════════════════════ -->
        <Border Grid.Column="1"
                Background="{StaticResource BgMidBrush}"
                BorderBrush="{StaticResource BorderMidBrush}"
                BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Section title -->
                <TextBlock Grid.Row="0"
                           Text="{Binding SectionTitle}"
                           FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource TextLightBrush}"
                           Margin="24,20,24,0"/>

                <!-- Title separator -->
                <Rectangle Grid.Row="1" Height="1"
                           Fill="{StaticResource BorderMidBrush}"
                           Margin="0,12,0,0" Opacity="0.6"/>

                <!-- ── Scrollable content ── -->
                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="0,0,0,0">
                    <Grid Margin="24,16,24,8">

                        <!-- ══════════ SECTION 0: ЗАГАЛЬНІ ══════════ -->
                        <StackPanel Visibility="{Binding IsGeneralSection,
                                                  Converter={StaticResource BoolToVis}}">

                            <!-- Quality row -->
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="190"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Якість відео"
                                               FontSize="15" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextLightBrush}"/>
                                    <TextBlock Text="Застосовується до нових записів"
                                               FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                                <ComboBox Grid.Column="1"
                                          Style="{StaticResource DarkComboBoxStyle}"
                                          VerticalAlignment="Center"
                                          ItemsSource="{Binding AvailableQualities}"
                                          SelectedItem="{Binding DefaultQuality}"
                                          DisplayMemberPath="Label"/>
                            </Grid>

                            <Rectangle Height="1" Fill="{StaticResource BorderMidBrush}"
                                       Opacity="0.4" Margin="0,14,0,14"/>

                            <!-- Mode row -->
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="190"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Режим роботи"
                                               FontSize="15" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextLightBrush}"/>
                                    <TextBlock Text="Режим логування відео"
                                               FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                                <ComboBox Grid.Column="1"
                                          Style="{StaticResource DarkComboBoxStyle}"
                                          VerticalAlignment="Center"
                                          ItemsSource="{Binding AvailableModes}"
                                          SelectedItem="{Binding DefaultMode}"
                                          DisplayMemberPath="DisplayName"/>
                            </Grid>

                            <!-- Mode overview header -->
                            <TextBlock Text="РЕЖИМИ ЗАПИСУ"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextDimBrush}"
                                       Margin="0,20,0,2" CharacterSpacing="100"/>
                            <Rectangle Height="1" Fill="{StaticResource BorderMidBrush}"
                                       Opacity="0.5" Margin="0,0,0,10"/>

                            <!-- Olympic info card -->
                            <Border Padding="14,12" CornerRadius="10" Margin="0,0,0,8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background"      Value="#0D1F1F"/>
                                        <Setter Property="BorderBrush"     Value="#2A3E40"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOlympicDefault}" Value="True">
                                                <Setter Property="BorderBrush"     Value="{StaticResource AccentGoldBrush}"/>
                                                <Setter Property="BorderThickness" Value="1.5"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource AccentGoldBrush}"
                                             HorizontalAlignment="Right" VerticalAlignment="Top"
                                             Visibility="{Binding IsOlympicDefault, Converter={StaticResource BoolToVis}}"/>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="🏆  Олімпіада" FontSize="13" FontWeight="Bold"
                                                       Foreground="{StaticResource AccentGoldBrush}"/>
                                            <Border Background="#1E3636" CornerRadius="8"
                                                    Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="Фіксований режим" FontSize="10"
                                                           Foreground="{StaticResource TextMutedBrush}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Максимальна деталізація: буфер, збереження, Run/Debug, бездіяльність та всі маркери"
                                                   FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Learning info card -->
                            <Border Padding="14,12" CornerRadius="10" Margin="0,0,0,8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background"      Value="{StaticResource BgCardBrush}"/>
                                        <Setter Property="BorderBrush"     Value="#2A3E40"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLearningDefault}" Value="True">
                                                <Setter Property="BorderBrush"     Value="{StaticResource AccentGoldBrush}"/>
                                                <Setter Property="BorderThickness" Value="1.5"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource AccentGoldBrush}"
                                             HorizontalAlignment="Right" VerticalAlignment="Top"
                                             Visibility="{Binding IsLearningDefault, Converter={StaticResource BoolToVis}}"/>
                                    <StackPanel>
                                        <TextBlock FontSize="13" FontWeight="Bold" Margin="0,0,0,6">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text"       Value="📚  Навчання"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLearningDefault}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource AccentGoldBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="Фокус на навчальному процесі: відміна дій, IDE-події та бездіяльність"
                                                   FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Personal info card -->
                            <Border Padding="14,12" CornerRadius="10" Margin="0,0,0,8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background"      Value="{StaticResource BgCardBrush}"/>
                                        <Setter Property="BorderBrush"     Value="#2A3E40"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPersonalDefault}" Value="True">
                                                <Setter Property="BorderBrush"     Value="{StaticResource AccentGoldBrush}"/>
                                                <Setter Property="BorderThickness" Value="1.5"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource AccentGoldBrush}"
                                             HorizontalAlignment="Right" VerticalAlignment="Top"
                                             Visibility="{Binding IsPersonalDefault, Converter={StaticResource BoolToVis}}"/>
                                    <StackPanel>
                                        <TextBlock FontSize="13" FontWeight="Bold" Margin="0,0,0,6">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text"       Value="🙂  Особистий"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPersonalDefault}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource AccentGoldBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="Гнучке налаштування під власний стиль роботи та вподобання"
                                                   FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Work info card -->
                            <Border Padding="14,12" CornerRadius="10" Margin="0,0,0,8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background"      Value="{StaticResource BgCardDimBrush}"/>
                                        <Setter Property="BorderBrush"     Value="#2A3E40"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsWorkDefault}" Value="True">
                                                <Setter Property="BorderBrush"     Value="{StaticResource AccentGoldBrush}"/>
                                                <Setter Property="BorderThickness" Value="1.5"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource AccentGoldBrush}"
                                             HorizontalAlignment="Right" VerticalAlignment="Top"
                                             Visibility="{Binding IsWorkDefault, Converter={StaticResource BoolToVis}}"/>
                                    <StackPanel>
                                        <TextBlock FontSize="13" FontWeight="Bold" Margin="0,0,0,6">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text"       Value="💼  Робота"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsWorkDefault}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource AccentGoldBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="Робочий процес: збереження файлів, запуск застосунків та буфер обміну"
                                                   FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                        </StackPanel>

                        <!-- ══════════ SECTION 1: ЛОГУВАННЯ ══════════ -->
                        <StackPanel Visibility="{Binding IsLoggingSection,
                                                  Converter={StaticResource BoolToVis}}">

                            <TextBlock Text="Оберіть події для кожного режиму запису."
                                       FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                       Margin="0,0,0,14"/>

                            <!-- Olympic -->
                            <Border Padding="14,12" CornerRadius="10" Margin="0,0,0,8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background"      Value="#0D1F1F"/>
                                        <Setter Property="BorderBrush"     Value="#2A3E40"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOlympicDefault}" Value="True">
                                                <Setter Property="BorderBrush"     Value="{StaticResource AccentGoldBrush}"/>
                                                <Setter Property="BorderThickness" Value="1.5"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource AccentGoldBrush}"
                                             HorizontalAlignment="Right" VerticalAlignment="Top"
                                             Visibility="{Binding IsOlympicDefault, Converter={StaticResource BoolToVis}}"/>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="🏆  Олімпіада" FontSize="13" FontWeight="Bold"
                                                       Foreground="{StaticResource AccentGoldBrush}"/>
                                            <Border Background="#1E3636" CornerRadius="8"
                                                    Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="Фіксований режим" FontSize="10"
                                                           Foreground="{StaticResource TextMutedBrush}"/>
                                            </Border>
                                        </StackPanel>
                                        <UniformGrid Columns="3">
                                            <CheckBox Style="{StaticResource GoldCheckBoxStyle}" Content="Буфер обміну"  IsChecked="True" IsEnabled="False"/>
                                            <CheckBox Style="{StaticResource GoldCheckBoxStyle}" Content="Збереження"    IsChecked="True" IsEnabled="False"/>
                                            <CheckBox Style="{StaticResource GoldCheckBoxStyle}" Content="Run / Debug"   IsChecked="True" IsEnabled="False"/>
                                            <CheckBox Style="{StaticResource GoldCheckBoxStyle}" Content="Бездіяльність" IsChecked="True" IsEnabled="False"/>
                                            <CheckBox Style="{StaticResource GoldCheckBoxStyle}" Content="Маркери"       IsChecked="True" IsEnabled="False"/>
                                            <CheckBox Style="{StaticResource GoldCheckBoxStyle}" Content="Скріншоти"     IsChecked="True" IsEnabled="False"/>
                                        </UniformGrid>
                                        <TextBlock Text="Не редагується"
                                                   FontSize="10" Foreground="{StaticResource TextDimBrush}"
                                                   Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Learning -->
                            <Border Padding="14,12" CornerRadius="10" Margin="0,0,0,8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background"      Value="{StaticResource BgCardBrush}"/>
                                        <Setter Property="BorderBrush"     Value="#2A3E40"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLearningDefault}" Value="True">
                                                <Setter Property="BorderBrush"     Value="{StaticResource AccentGoldBrush}"/>
                                                <Setter Property="BorderThickness" Value="1.5"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource AccentGoldBrush}"
                                             HorizontalAlignment="Right" VerticalAlignment="Top"
                                             Visibility="{Binding IsLearningDefault, Converter={StaticResource BoolToVis}}"/>
                                    <StackPanel>
                                        <TextBlock FontSize="13" FontWeight="Bold" Margin="0,0,0,8">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text"       Value="📚  Навчання"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLearningDefault}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource AccentGoldBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <UniformGrid Columns="3">
                                            <CheckBox Style="{StaticResource GoldCheckBoxStyle}" Content="Буфер обміну"  IsChecked="{Binding LearningClipboard}"/>
                                            <CheckBox Style="{StaticResource GoldCheckBoxStyle}" Content="Збереження"    IsChecked="{Binding LearningFileSave}"/>
                                            <CheckBox Style="{StaticResource GoldCheckBoxStyle}" Content="Run / Debug"   IsChecked="{Binding LearningRunDebug}"/>
                                            <CheckBox Style="{StaticResource GoldCheckBoxStyle}" Content="Бездіяльність" IsChecked="{Binding LearningIdle}"/>
                                            <CheckBox Style="{StaticResource GoldCheckBoxStyle}" Content="Відміна (Undo)" IsChecked="{Binding LearningUndo}"/>
                                        </UniformGrid>
                                        <TextBlock Text="+ Маркери · Скріншоти"
                                                   FontSize="10" Foreground="{StaticResource AccentTealBrush}"
                                                   Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Personal -->
                            <Border Padding="14,12" CornerRadius="10" Margin="0,0,0,8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background"      Value="{StaticResource BgCardBrush}"/>
                                        <Setter Property="BorderBrush"     Value="#2A3E40"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPersonalDefault}" Value="True">
                                                <Setter Property="BorderBrush"     Value="{StaticResource AccentGoldBrush}"/>
                                                <Setter Property="BorderThickness" Value="1.5"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource AccentGoldBrush}"
                                             HorizontalAlignment="Right" VerticalAlignment="Top"
                                             Visibility="{Binding IsPersonalDefault, Converter={StaticResource BoolToVis}}"/>
                                    <StackPanel>
                                        <TextBlock FontSize="13" FontWeight="Bold" Margin="0,0,0,8">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text"       Value="🙂  Особистий"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPersonalDefault}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource AccentGoldBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <UniformGrid Columns="3">
                                            <CheckBox Style="{StaticResource GoldCheckBoxStyle}" Content="Буфер обміну"    IsChecked="{Binding PersonalClipboard}"/>
                                            <CheckBox Style="{StaticResource GoldCheckBoxStyle}" Content="Збереження"      IsChecked="{Binding PersonalFileSave}"/>
                                            <CheckBox Style="{StaticResource GoldCheckBoxStyle}" Content="Run / Debug"     IsChecked="{Binding PersonalRunDebug}"/>
                                            <CheckBox Style="{StaticResource GoldCheckBoxStyle}" Content="Бездіяльність"   IsChecked="{Binding PersonalIdle}"/>
                                            <CheckBox Style="{StaticResource GoldCheckBoxStyle}" Content="IDE події"       IsChecked="{Binding PersonalIde}"/>
                                            <CheckBox Style="{StaticResource GoldCheckBoxStyle}" Content="Авто-збереження" IsChecked="{Binding PersonalAutoSave}"/>
                                        </UniformGrid>
                                        <TextBlock Text="+ Маркери · Скріншоти"
                                                   FontSize="10" Foreground="{StaticResource AccentTealBrush}"
                                                   Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Work -->
                            <Border Padding="14,12" CornerRadius="10" Margin="0,0,0,8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background"      Value="{StaticResource BgCardDimBrush}"/>
                                        <Setter Property="BorderBrush"     Value="#2A3E40"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsWorkDefault}" Value="True">
                                                <Setter Property="BorderBrush"     Value="{StaticResource AccentGoldBrush}"/>
                                                <Setter Property="BorderThickness" Value="1.5"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource AccentGoldBrush}"
                                             HorizontalAlignment="Right" VerticalAlignment="Top"
                                             Visibility="{Binding IsWorkDefault, Converter={StaticResource BoolToVis}}"/>
                                    <StackPanel>
                                        <TextBlock FontSize="13" FontWeight="Bold" Margin="0,0,0,8">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text"       Value="💼  Робота"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsWorkDefault}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource AccentGoldBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <UniformGrid Columns="3">
                                            <CheckBox Style="{StaticResource GoldCheckBoxStyle}" Content="Буфер обміну"  IsChecked="{Binding WorkClipboard}"/>
                                            <CheckBox Style="{StaticResource GoldCheckBoxStyle}" Content="Збереження"    IsChecked="{Binding WorkFileSave}"/>
                                            <CheckBox Style="{StaticResource GoldCheckBoxStyle}" Content="Run / Debug"   IsChecked="{Binding WorkRunDebug}"/>
                                            <CheckBox Style="{StaticResource GoldCheckBoxStyle}" Content="Бездіяльність" IsChecked="{Binding WorkIdle}"/>
                                        </UniformGrid>
                                        <TextBlock Text="+ Маркери · Скріншоти"
                                                   FontSize="10" Foreground="{StaticResource TextDimBrush}"
                                                   Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                        </StackPanel>

                        <!-- ══════════ SECTION 2: ГАРЯЧІ КЛАВІШІ ══════════ -->
                        <StackPanel Visibility="{Binding IsHotkeysSection,
                                                  Converter={StaticResource BoolToVis}}">

                            <!-- AlgoReplay globals -->
                            <TextBlock Text="AlgoReplay — глобальні"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextLightBrush}"
                                       Margin="0,0,0,8"/>
                            <Border Background="{StaticResource BgCardBrush}"
                                    CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Grid.Column="0" Background="#1A3A4A" CornerRadius="4"
                                            Padding="7,3" Margin="0,3,8,3" HorizontalAlignment="Left">
                                        <TextBlock Text="Ctrl+Shift+R" FontFamily="Consolas" FontSize="12"
                                                   Foreground="{StaticResource AccentTealBrush}"/>
                                    </Border>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Старт / Стоп запису"
                                               VerticalAlignment="Center" Margin="0,3"
                                               Foreground="{StaticResource TextLightBrush}" FontSize="13"/>

                                    <Border Grid.Row="1" Grid.Column="0" Background="#1A3A4A" CornerRadius="4"
                                            Padding="7,3" Margin="0,3,8,3" HorizontalAlignment="Left">
                                        <TextBlock Text="Ctrl+Shift+M" FontFamily="Consolas" FontSize="12"
                                                   Foreground="{StaticResource AccentTealBrush}"/>
                                    </Border>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Додати маркер"
                                               VerticalAlignment="Center" Margin="0,3"
                                               Foreground="{StaticResource TextLightBrush}" FontSize="13"/>

                                    <Border Grid.Row="2" Grid.Column="0" Background="#1A3A4A" CornerRadius="4"
                                            Padding="7,3" Margin="0,3,8,3" HorizontalAlignment="Left">
                                        <TextBlock Text="Ctrl+Shift+S" FontFamily="Consolas" FontSize="12"
                                                   Foreground="{StaticResource AccentTealBrush}"/>
                                    </Border>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Зробити скріншот"
                                               VerticalAlignment="Center" Margin="0,3"
                                               Foreground="{StaticResource TextLightBrush}" FontSize="13"/>
                                </Grid>
                            </Border>

                            <!-- Screenshot editor -->
                            <TextBlock Text="Редактор скріншотів"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextLightBrush}"
                                       Margin="0,0,0,8"/>
                            <Border Background="{StaticResource BgCardBrush}"
                                    CornerRadius="8" Padding="14,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Tool hotkeys -->
                                    <Border Grid.Row="0" Grid.Column="0" Background="#1E2E30" CornerRadius="4" Padding="7,3" Margin="0,2,8,2" HorizontalAlignment="Left">
                                        <TextBlock Text="S" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                    </Border>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Виділення та переміщення" VerticalAlignment="Center" Margin="0,2" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>

                                    <Border Grid.Row="1" Grid.Column="0" Background="#1E2E30" CornerRadius="4" Padding="7,3" Margin="0,2,8,2" HorizontalAlignment="Left">
                                        <TextBlock Text="A" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                    </Border>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Стрілка" VerticalAlignment="Center" Margin="0,2" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>

                                    <Border Grid.Row="2" Grid.Column="0" Background="#1E2E30" CornerRadius="4" Padding="7,3" Margin="0,2,8,2" HorizontalAlignment="Left">
                                        <TextBlock Text="R" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                    </Border>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Прямокутник" VerticalAlignment="Center" Margin="0,2" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>

                                    <Border Grid.Row="3" Grid.Column="0" Background="#1E2E30" CornerRadius="4" Padding="7,3" Margin="0,2,8,2" HorizontalAlignment="Left">
                                        <TextBlock Text="P" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                    </Border>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="Олівець (вільний)" VerticalAlignment="Center" Margin="0,2" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>

                                    <Border Grid.Row="4" Grid.Column="0" Background="#1E2E30" CornerRadius="4" Padding="7,3" Margin="0,2,8,2" HorizontalAlignment="Left">
                                        <TextBlock Text="T" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                    </Border>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="Текст" VerticalAlignment="Center" Margin="0,2" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>

                                    <Border Grid.Row="5" Grid.Column="0" Background="#1E2E30" CornerRadius="4" Padding="7,3" Margin="0,2,8,2" HorizontalAlignment="Left">
                                        <TextBlock Text="M" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                    </Border>
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="Маркер (виділення)" VerticalAlignment="Center" Margin="0,2" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>

                                    <Border Grid.Row="6" Grid.Column="0" Background="#1E2E30" CornerRadius="4" Padding="7,3" Margin="0,2,8,2" HorizontalAlignment="Left">
                                        <TextBlock Text="E" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                    </Border>
                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="Гумка" VerticalAlignment="Center" Margin="0,2" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>

                                    <Border Grid.Row="7" Grid.Column="0" Background="#1E2E30" CornerRadius="4" Padding="7,3" Margin="0,2,8,2" HorizontalAlignment="Left">
                                        <TextBlock Text="Ctrl+Z" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                    </Border>
                                    <TextBlock Grid.Row="7" Grid.Column="1" Text="Відміна дії" VerticalAlignment="Center" Margin="0,2" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>

                                    <Border Grid.Row="8" Grid.Column="0" Background="#1E2E30" CornerRadius="4" Padding="7,3" Margin="0,2,8,2" HorizontalAlignment="Left">
                                        <TextBlock Text="Ctrl+S" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                    </Border>
                                    <TextBlock Grid.Row="8" Grid.Column="1" Text="Зберегти скріншот" VerticalAlignment="Center" Margin="0,2" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>

                                    <Border Grid.Row="9" Grid.Column="0" Background="#1E2E30" CornerRadius="4" Padding="7,3" Margin="0,2,8,2" HorizontalAlignment="Left">
                                        <TextBlock Text="Ctrl+Enter" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                    </Border>
                                    <TextBlock Grid.Row="9" Grid.Column="1" Text="Підтвердити текст" VerticalAlignment="Center" Margin="0,2" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>

                                    <Border Grid.Row="10" Grid.Column="0" Background="#1E2E30" CornerRadius="4" Padding="7,3" Margin="0,2,8,2" HorizontalAlignment="Left">
                                        <TextBlock Text="Delete" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                    </Border>
                                    <TextBlock Grid.Row="10" Grid.Column="1" Text="Видалити елемент" VerticalAlignment="Center" Margin="0,2" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>

                                    <Border Grid.Row="11" Grid.Column="0" Background="#1E2E30" CornerRadius="4" Padding="7,3" Margin="0,2,8,2" HorizontalAlignment="Left">
                                        <TextBlock Text="Ctrl+Scroll" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                    </Border>
                                    <TextBlock Grid.Row="11" Grid.Column="1" Text="Змінити розмір пензля" VerticalAlignment="Center" Margin="0,2" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                                </Grid>
                            </Border>

                        </StackPanel>

                    </Grid>
                </ScrollViewer>

                <!-- ── Bottom bar ── -->
                <Border Grid.Row="3"
                        Background="{StaticResource BgCardBrush}"
                        BorderBrush="{StaticResource BorderMidBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="24,0">
                    <Grid Height="52">
                        <TextBlock Text="Зміни не збережено"
                                   Foreground="{StaticResource AccentGoldBrush}"
                                   FontSize="12" VerticalAlignment="Center"
                                   HorizontalAlignment="Left"/>
                        <TextBlock Text="{Binding SaveStatus}"
                                   Foreground="{StaticResource AccentTealBrush}"
                                   FontSize="12" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"
                                   Margin="160,0,0,0"/>
                        <Button Content="Зберегти"
                                Command="{Binding SaveSettingsCommand}"
                                Style="{StaticResource SaveBtnStyle}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"/>
                    </Grid>
                </Border>

            </Grid>
        </Border>

    </Grid>
</UserControl>
