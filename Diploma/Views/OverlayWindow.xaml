<Window x:Class="Diploma.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AlgoReplay Overlay"
        Width="660" SizeToContent="Height" MinHeight="44"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="IconBtnStyle" TargetType="Button">
            <Setter Property="Width"           Value="32"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Background"      Value="#1A2C2E"/>
            <Setter Property="BorderBrush"     Value="#2D4C4F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground"      Value="#D9E9E9"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background"  Value="#2D4C4F"/>
                                <Setter TargetName="B" Property="BorderBrush" Value="#78B4B7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#1A3A4A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="B" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RecordBtnStyle" TargetType="Button" BasedOn="{StaticResource IconBtnStyle}">
            <Setter Property="Background"  Value="#331010"/>
            <Setter Property="BorderBrush" Value="#83241E"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background"  Value="#83241E"/>
                    <Setter Property="BorderBrush" Value="#CC3333"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MicBtnStyle" TargetType="Button" BasedOn="{StaticResource IconBtnStyle}">
            <Setter Property="Background"  Value="#1A2D30"/>
            <Setter Property="BorderBrush" Value="#3D6E7A"/>
        </Style>

        <Style x:Key="SettingsBtnStyle" TargetType="Button" BasedOn="{StaticResource IconBtnStyle}">
            <Setter Property="Background"  Value="#2A1E08"/>
            <Setter Property="BorderBrush" Value="#BD8B33"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background"  Value="#3D2A0A"/>
                    <Setter Property="BorderBrush" Value="#E0AA55"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="CollapsedStrip"
                Grid.Row="0"
                Height="4"
                VerticalAlignment="Top"
                Background="#78B4B7"
                CornerRadius="0,0,4,4"
                Cursor="Hand"
                Visibility="Collapsed"
                MouseEnter="Strip_MouseEnter"
                MouseLeftButtonDown="Strip_Click"/>

        <Border x:Name="ExpandedBar"
                Grid.Row="0"
                Height="44"
                VerticalAlignment="Top"
                Background="#D0102020"
                CornerRadius="0,0,14,14"
                MouseMove="Bar_MouseMove">

            <Grid Margin="10,0,10,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Button x:Name="RecordBtn"
                            Style="{StaticResource RecordBtnStyle}"
                            Click="RecordBtn_Click"
                            Margin="0,0,6,0"
                            ToolTip="Почати / Зупинити запис">
                        <Grid Width="16" Height="16">
                            <Ellipse Width="12" Height="12" Fill="#CC3333">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <Rectangle Width="10" Height="10" Fill="White" RadiusX="2" RadiusY="2">
                                <Rectangle.Style>
                                    <Style TargetType="Rectangle">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation
                                                                Storyboard.TargetProperty="Opacity"
                                                                From="1" To="0.4"
                                                                Duration="0:0:0.7"
                                                                AutoReverse="True"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Rectangle.Style>
                            </Rectangle>
                        </Grid>
                    </Button>

                    <Button x:Name="MicBtn"
                            Click="MicBtn_Click"
                            Margin="0,0,10,0"
                            ToolTip="Мікрофон">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MicBtnStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   FontSize="14" Text="&#xE720;">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#78B4B7"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMicEnabled}" Value="False">
                                            <Setter Property="Foreground" Value="#506870"/>
                                            <Setter Property="TextDecorations" Value="Strikethrough"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <TextBlock Text="{Binding RecordingDuration,
                                      StringFormat={}{0:hh\\:mm\\:ss}}"
                               FontFamily="Consolas"
                               FontSize="18" FontWeight="Bold"
                               Foreground="#D9E9E9"
                               VerticalAlignment="Center"/>

                    <Ellipse x:Name="DropDot"
                             Width="6" Height="6"
                             Fill="#FF4444"
                             VerticalAlignment="Center"
                             Margin="8,0,0,0"
                             Visibility="Collapsed"/>

                    <TextBlock x:Name="DiskLabel"
                               FontFamily="Consolas"
                               FontSize="12"
                               Foreground="#9FA6A6"
                               VerticalAlignment="Center"
                               Margin="16,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Button Command="{Binding AddMarkerCommand}"
                            Margin="0,0,6,0"
                            ToolTip="Маркер (Ctrl+Shift+M)">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconBtnStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRecording}" Value="False">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   FontSize="14" Text="&#xE70F;"
                                   Foreground="#78B4B7"/>
                    </Button>

                    <Button Command="{Binding TakeScreenshotCommand}"
                            Margin="0,0,6,0"
                            ToolTip="Скріншот (Ctrl+Shift+S)">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconBtnStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRecording}" Value="False">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   FontSize="14" Text="&#xE722;"
                                   Foreground="#78B4B7"/>
                    </Button>

                    <Button Style="{StaticResource IconBtnStyle}"
                            Click="WhiteboardBtn_Click"
                            Margin="0,0,6,0"
                            ToolTip="Дошка">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   FontSize="14" Text="&#xE7C9;"
                                   Foreground="#78B4B7"/>
                    </Button>

                    <Button Style="{StaticResource IconBtnStyle}"
                            Click="SessionsBtn_Click"
                            Margin="0,0,6,0"
                            ToolTip="Сесії">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   FontSize="14" Text="&#xE292;"
                                   Foreground="#78B4B7"/>
                    </Button>

                    <Button Style="{StaticResource SettingsBtnStyle}"
                            Click="SettingsBtn_Click"
                            ToolTip="Налаштування">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   FontSize="14" Text="&#xE713;"
                                   Foreground="#BD8B33"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="ViolationPanel"
                Grid.Row="1"
                Height="32"
                Background="#CC83241E"
                CornerRadius="0,0,10,10"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="⚠  "
                           Foreground="#FF8A80" FontSize="13" FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="ViolationText"
                           Foreground="White" FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>