<Window x:Class="Diploma.Views.WhiteboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Дошка"
        Width="1100" Height="720"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Focusable="True"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Width"           Value="32"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Foreground"      Value="#CCCCCC"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#33FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ToolBtnActive" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
            <Setter Property="Background" Value="#44FFFFFF"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
    </Window.Resources>

    <Border Background="#1C1C1E" CornerRadius="10"
            BorderBrush="#3A3A3C" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="44"/>
            </Grid.RowDefinitions>

            <!-- Titlebar -->
            <Border Grid.Row="0" CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="TitleBar_MouseDown"
                    Background="Transparent" Cursor="SizeAll">
                <Grid Margin="12,0">
                    <TextBlock Text="Дошка"
                               Foreground="#888" FontSize="12"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button x:Name="BtnFullscreen"
                                Click="FullscreenBtn_Click"
                                Style="{StaticResource ToolBtn}"
                                Foreground="#666"
                                Margin="0,0,4,0"
                                ToolTip="На весь екран">
                            <TextBlock x:Name="FullscreenIcon"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="12" Text="&#xE922;"/>
                        </Button>
                        <Button Content="✕"
                                Style="{StaticResource ToolBtn}"
                                Click="CloseButton_Click"
                                Foreground="#666"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- White canvas -->
            <Border Grid.Row="1" Background="#FFFFFF" ClipToBounds="True">
                <InkCanvas x:Name="DrawingCanvas"
                           Background="Transparent"
                           EditingMode="None"
                           ClipToBounds="True"
                           MouseDown="DrawingCanvas_MouseDown"
                           MouseMove="DrawingCanvas_MouseMove"
                           MouseUp="DrawingCanvas_MouseUp"
                           PreviewMouseWheel="DrawingCanvas_PreviewMouseWheel"/>
            </Border>

            <!-- Bottom toolbar -->
            <Border Grid.Row="2" Background="#2C2C2E"
                    CornerRadius="0,0,10,10"
                    BorderBrush="#3A3A3C" BorderThickness="0,1,0,0">
                <Grid Margin="12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                        <Button x:Name="BtnPen" Click="Tool_Click" Tag="Pen"
                                Style="{StaticResource ToolBtnActive}"
                                ToolTip="Олівець [P]">
                            <Button.Content>
                                <Path Data="M4,14 L10,3 L13,6 L7,17 L4,17 Z"
                                      Stroke="#CCCCCC" StrokeThickness="1.5"
                                      Fill="Transparent"/>
                            </Button.Content>
                        </Button>

                        <Button x:Name="BtnText" Click="Tool_Click" Tag="Text"
                                Style="{StaticResource ToolBtn}"
                                ToolTip="Текст [T]">
                            <Button.Content>
                                <TextBlock Text="T" Foreground="#CCCCCC"
                                           FontSize="15" FontWeight="Medium"
                                           VerticalAlignment="Center"/>
                            </Button.Content>
                        </Button>

                        <Button x:Name="BtnRect" Click="Tool_Click" Tag="Rect"
                                Style="{StaticResource ToolBtn}"
                                ToolTip="Прямокутник [R]">
                            <Button.Content>
                                <Rectangle Width="14" Height="10"
                                           Stroke="#CCCCCC" StrokeThickness="1.5"
                                           Fill="Transparent"/>
                            </Button.Content>
                        </Button>

                        <Button x:Name="BtnEraser" Click="Tool_Click" Tag="Eraser"
                                Style="{StaticResource ToolBtn}"
                                ToolTip="Гумка [E]">
                            <Button.Content>
                                <Path Data="M3,13 L9,5 L15,9 L9,17 Z M9,17 L15,17"
                                      Stroke="#CCCCCC" StrokeThickness="1.5"
                                      Fill="Transparent"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"/>
                            </Button.Content>
                        </Button>

                        <Rectangle Width="1" Height="20" Fill="#3A3A3C" Margin="6,0"/>

                        <ItemsControl x:Name="ColorPicker" Margin="0,0,6,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="18" Height="18" Tag="{Binding}"
                                            Click="Color_Click"
                                            BorderThickness="0" Cursor="Hand"
                                            Margin="0,0,4,0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Ellipse Width="18" Height="18">
                                                    <Ellipse.Fill>
                                                        <SolidColorBrush Color="{Binding}"/>
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Rectangle Width="1" Height="20" Fill="#3A3A3C" Margin="6,0"/>

                        <TextBlock Text="Розмір:" Foreground="#666" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Slider x:Name="ThicknessSlider"
                                Minimum="1" Maximum="20" Value="2"
                                Width="70" VerticalAlignment="Center"
                                ValueChanged="ThicknessSlider_ValueChanged"/>

                        <Rectangle Width="1" Height="20" Fill="#3A3A3C" Margin="6,0"/>

                        <Button Style="{StaticResource ToolBtn}" Click="Undo_Click"
                                ToolTip="Скасувати (Ctrl+Z)">
                            <Button.Content>
                                <Path Data="M5,9 A5,5 0 1 1 10,14 M5,6 L5,9 L8,9"
                                      Stroke="#CCCCCC" StrokeThickness="1.5"
                                      Fill="Transparent"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Button.Content>
                        </Button>
                    </StackPanel>

                    <Button Content="Очистити"
                            HorizontalAlignment="Right"
                            Padding="16,0" Height="28"
                            Background="#3A1010"
                            Foreground="#FF6B6B"
                            BorderThickness="0"
                            FontSize="13"
                            Click="ClearAll_Click"
                            ToolTip="Очистити дошку (Ctrl+Delete)">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="6"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#551010"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
