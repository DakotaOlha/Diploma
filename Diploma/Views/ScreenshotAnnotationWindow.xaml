<Window x:Class="Diploma.Views.ScreenshotAnnotationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Скріншот"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Width"           Value="32"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Foreground"      Value="#CCCCCC"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#33FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ToolBtnActive" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
            <Setter Property="Background" Value="#44FFFFFF"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
    </Window.Resources>

    <Border Background="#1C1C1E" CornerRadius="10"
            BorderBrush="#3A3A3C" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>  <!-- titlebar -->
                <RowDefinition Height="*"/>   <!-- canvas area -->
                <RowDefinition Height="44"/>  <!-- bottom bar -->
            </Grid.RowDefinitions>

            <!-- Titlebar -->
            <Border Grid.Row="0" CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="TitleBar_MouseDown"
                    Background="Transparent" Cursor="SizeAll">
                <Grid Margin="12,0">
                    <TextBlock Text="Редагування скріншоту"
                               Foreground="#888" FontSize="12"
                               VerticalAlignment="Center"/>
                    <Button Content="✕" Style="{StaticResource ToolBtn}"
                            HorizontalAlignment="Right"
                            Click="CloseButton_Click"
                            Foreground="#666"/>
                </Grid>
            </Border>

            <!-- Canvas area -->
            <Border Grid.Row="1" Background="#000" ClipToBounds="True">
                <Grid x:Name="CanvasHost">
                    <Image x:Name="SourceImage"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                    <InkCanvas x:Name="DrawingCanvas"
                               Background="Transparent"
                               EditingMode="None"
                               ClipToBounds="True"
                               MouseDown="DrawingCanvas_MouseDown"
                               MouseMove="DrawingCanvas_MouseMove"
                               MouseUp="DrawingCanvas_MouseUp"/>
                </Grid>
            </Border>

            <!-- Bottom bar -->
            <Border Grid.Row="2" Background="#2C2C2E"
                    CornerRadius="0,0,10,10"
                    BorderBrush="#3A3A3C" BorderThickness="0,1,0,0">
                <Grid Margin="12,0">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <Button x:Name="BtnArrow"   Click="Tool_Click" Tag="Arrow"
                                Style="{StaticResource ToolBtnActive}" ToolTip="Стрілка">
                            <Button.Content>
                                <Path Data="M4,12 L12,4 M12,4 L12,9 M12,4 L7,4"
                                      Stroke="#FFFFFF" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"/>
                            </Button.Content>
                        </Button>

                        <Button x:Name="BtnRect"    Click="Tool_Click" Tag="Rect"
                                Style="{StaticResource ToolBtn}" ToolTip="Прямокутник">
                            <Button.Content>
                                <Rectangle Width="14" Height="10"
                                           Stroke="#CCCCCC" StrokeThickness="1.5"
                                           Fill="Transparent"/>
                            </Button.Content>
                        </Button>

                        <Button x:Name="BtnPen"     Click="Tool_Click" Tag="Pen"
                                Style="{StaticResource ToolBtn}" ToolTip="Олівець">
                            <Button.Content>
                                <Path Data="M4,14 L10,3 L13,6 L7,17 L4,17 Z"
                                      Stroke="#CCCCCC" StrokeThickness="1.5"
                                      Fill="Transparent"/>
                            </Button.Content>
                        </Button>

                        <Button x:Name="BtnText"    Click="Tool_Click" Tag="Text"
                                Style="{StaticResource ToolBtn}" ToolTip="Текст">
                            <Button.Content>
                                <TextBlock Text="T" Foreground="#CCCCCC"
                                           FontSize="15" FontWeight="Medium"
                                           VerticalAlignment="Center"/>
                            </Button.Content>
                        </Button>

                        <Button x:Name="BtnHighlight" Click="Tool_Click" Tag="Highlight"
                                Style="{StaticResource ToolBtn}" ToolTip="Виділення">
                            <Button.Content>
                                <Rectangle Width="16" Height="8" RadiusX="1" RadiusY="1"
                                           Fill="#55FFD700" Stroke="#FFD700" StrokeThickness="1"/>
                            </Button.Content>
                        </Button>

                        <!-- Separator -->
                        <Rectangle Width="1" Height="20" Fill="#3A3A3C" Margin="6,0"/>

                        <!-- Color swatches -->
                        <ItemsControl x:Name="ColorPicker" Margin="0,0,6,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="18" Height="18" Tag="{Binding}"
                                            Click="Color_Click"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Margin="0,0,4,0">
                                        <Button.Background>
                                            <SolidColorBrush Color="{Binding}"/>
                                        </Button.Background>
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Ellipse Width="18" Height="18">
                                                    <Ellipse.Fill>
                                                        <SolidColorBrush Color="{Binding}"/>
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Separator -->
                        <Rectangle Width="1" Height="20" Fill="#3A3A3C" Margin="6,0"/>

                        <!-- Thickness -->
                        <TextBlock Text="Розмір:" Foreground="#666" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Slider x:Name="ThicknessSlider"
                                Minimum="1" Maximum="12" Value="2"
                                Width="70" VerticalAlignment="Center"
                                ValueChanged="ThicknessSlider_ValueChanged"/>

                        <!-- Undo -->
                        <Rectangle Width="1" Height="20" Fill="#3A3A3C" Margin="6,0"/>
                        <Button Style="{StaticResource ToolBtn}" Click="Undo_Click"
                                ToolTip="Скасувати (Ctrl+Z)">
                            <Button.Content>
                                <Path Data="M5,9 A5,5 0 1 1 10,14 M5,6 L5,9 L8,9"
                                      Stroke="#CCCCCC" StrokeThickness="1.5"
                                      Fill="Transparent"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Button.Content>
                        </Button>
                    </StackPanel>

                    <!-- Save button -->
                    <Button Content="Зберегти"
                            HorizontalAlignment="Right"
                            Padding="16,0" Height="28"
                            Background="#0A84FF"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="13"
                            Click="Save_Click"
                            ToolTip="Зберегти (Ctrl+S)">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="6"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#0070E0"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>