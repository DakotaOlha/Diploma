<Window x:Class="Diploma.Views.ScreenshotAnnotationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Diploma.Views"
        Title="Редактор скріншоту"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Focusable="True"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- Базовий стиль для кнопок інструментів -->
        <local:ColorToBrushConverter x:Key="ColorToBrushConverter"/>
        
        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="Margin" Value="2,0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#33FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для активного інструменту -->
        <Style x:Key="ToolBtnActive" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
            <Setter Property="Background" Value="#44FFFFFF"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
    </Window.Resources>

    <Border Background="#1C1C1E" CornerRadius="12" 
            BorderBrush="#3A3A3C" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>  <!-- Заголовок -->
                <RowDefinition Height="*"/>   <!-- Полотно -->
                <RowDefinition Height="50"/>  <!-- Панель інструментів -->
            </Grid.RowDefinitions>

            <!-- TitleBar (Drag handle) -->
            <Border Grid.Row="0" CornerRadius="12,12,0,0" 
                    MouseLeftButtonDown="TitleBar_MouseDown" 
                    Background="Transparent" Cursor="SizeAll">
                <Grid Margin="15,0">
                    <TextBlock Text="Редагування скріншоту" 
                               Foreground="#888" FontSize="12" 
                               VerticalAlignment="Center"/>
                    <Button Content="✕" Style="{StaticResource ToolBtn}" 
                            HorizontalAlignment="Right" 
                            Click="CloseButton_Click" 
                            Foreground="#666" FontSize="14"/>
                </Grid>
            </Border>

            <!-- Область малювання -->
            <Border Grid.Row="1" Background="#000" ClipToBounds="True" Margin="2,0">
                <Grid x:Name="CanvasHost">
                    <Image x:Name="SourceImage" 
                           Stretch="Uniform" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"/>
                    
                    <!-- InkCanvas з прозорим фоном для малювання поверх фото -->
                    <InkCanvas x:Name="DrawingCanvas" 
                               Background="Transparent" 
                               EditingMode="None"
                               MouseDown="DrawingCanvas_MouseDown" 
                               MouseMove="DrawingCanvas_MouseMove" 
                               MouseUp="DrawingCanvas_MouseUp"/>
                </Grid>
            </Border>

            <!-- Нижня панель інструментів -->
            <Border Grid.Row="2" Background="#2C2C2E" 
                    CornerRadius="0,0,12,12" 
                    BorderBrush="#3A3A3C" BorderThickness="0,1,0,0">
                <Grid Margin="12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                        <!-- Вибір (Arrow) -->
                        <Button x:Name="BtnArrow" Click="Tool_Click" Tag="Arrow" 
                                Style="{StaticResource ToolBtnActive}" ToolTip="Вибір [V]">
                            <Path Data="M4,12 L12,4 M12,4 L12,9 M12,4 L7,4" 
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Button>

                        <!-- Прямокутник -->
                        <Button x:Name="BtnRect" Click="Tool_Click" Tag="Rect" 
                                Style="{StaticResource ToolBtn}" ToolTip="Прямокутник [R]">
                            <Rectangle Width="16" Height="12" StrokeThickness="1.5"
                                       Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>

                        <!-- Олівець -->
                        <Button x:Name="BtnPen" Click="Tool_Click" Tag="Pen" 
                                Style="{StaticResource ToolBtn}" ToolTip="Олівець [P]">
                            <Path Data="M4,14 L10,3 L13,6 L7,17 Z" 
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                                  StrokeThickness="1.5"/>
                        </Button>

                        <!-- Текст -->
                        <Button x:Name="BtnText" Click="Tool_Click" Tag="Text" 
                                Style="{StaticResource ToolBtn}" ToolTip="Текст [T]">
                            <TextBlock Text="T" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </Button>

                        <!-- Маркер (Highlight) -->
                        <Button x:Name="BtnHighlight" Click="Tool_Click" Tag="Highlight" 
                                Style="{StaticResource ToolBtn}" ToolTip="Маркер [M]">
                            <Rectangle Width="18" Height="6" Fill="#55FFD700" RadiusX="2" RadiusY="2"/>
                        </Button>

                        <!-- Гумка -->
                        <Button x:Name="BtnEraser" Click="Tool_Click" Tag="Eraser" 
                                Style="{StaticResource ToolBtn}" ToolTip="Гумка [E]">
                            <Path Data="M3,13 L9,5 L15,9 L9,17 Z M9,17 L15,17" 
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                                  StrokeThickness="1.5" StrokeLineJoin="Round"/>
                        </Button>

                        <Rectangle Width="1" Height="24" Fill="#3A3A3C" Margin="10,0"/>

                        <!-- Палітра кольорів -->
                        <ItemsControl x:Name="ColorPicker">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="20" Height="20" Margin="3,0" Click="Color_Click" Tag="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Ellipse Fill="{Binding Converter={StaticResource ColorToBrushConverter}}" 
                                                         Stroke="#44FFFFFF" StrokeThickness="1" Cursor="Hand"/>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Rectangle Width="1" Height="24" Fill="#3A3A3C" Margin="10,0"/>

                        <!-- Товщина -->
                        <Slider x:Name="ThicknessSlider" Minimum="1" Maximum="15" Value="2" 
                                Width="80" VerticalAlignment="Center" 
                                ValueChanged="ThicknessSlider_ValueChanged" ToolTip="Товщина лінії"/>

                        <!-- Undo -->
                        <Button Style="{StaticResource ToolBtn}" Click="Undo_Click" Margin="10,0" ToolTip="Назад [Ctrl+Z]">
                            <Path Data="M4,10 A6,6 0 1 1 10,16 M4,10 L4,6 L8,10 Z" 
                                  Stroke="#CCC" StrokeThickness="1.5"/>
                        </Button>
                    </StackPanel>

                    <!-- Кнопка збереження -->
                    <Button Content="Зберегти" HorizontalAlignment="Right" 
                            VerticalAlignment="Center" Padding="20,6"
                            Background="#0A84FF" Foreground="White" 
                            FontWeight="SemiBold" Click="Save_Click" 
                            ToolTip="Зберегти [Ctrl+S]">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>